# Copy to .env.local for local development. Never commit real values.
# Leave a value EMPTY rather than pasting a placeholder: a placeholder looks
# "configured" to the app (this is how production once ran on demo data).
NEXT_PUBLIC_SUPABASE_URL=https://example.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=
APP_BASE_URL=http://localhost:3000

# LINE (docs/15 section 4) — Messaging API and LINE Login under ONE Provider
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=
LINE_MESSAGING_CHANNEL_SECRET=
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# Shared with the GitHub secret of the same name (docs/15 section 6)
NOTIFICATIONS_CRON_SECRET=
